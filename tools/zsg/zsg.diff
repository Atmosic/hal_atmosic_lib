@@ -0,0 +1,74 @@
+#!/bin/bash
+# SPDX-FileCopyrightText: 2025 Atmosic
+# SPDX-License-Identifier: Apache-2.0
+
+# Script to build zephyr-settings-generator as a statically linked binary
+# This creates a binary that can run on Rocky Linux and other distributions
+# without dynamic library version dependencies
+
+set -e
+
+BUILD_DIR="${BUILD_DIR:-build-static}"
+BUILD_TYPE="${BUILD_TYPE:-Release}"
+INSTALL_PREFIX="${INSTALL_PREFIX:-/usr/local}"
+
+echo "Building zephyr-settings-generator as static binary..."
+echo "  Build directory: $BUILD_DIR"
+echo "  Build type: $BUILD_TYPE"
+echo "  Install prefix: $INSTALL_PREFIX"
+
+# Clean build directory if requested
+if [ "$1" == "clean" ]; then
+    echo "Cleaning build directory..."
+    rm -rf "$BUILD_DIR"
+fi
+
+# Create build directory
+mkdir -p "$BUILD_DIR"
+cd "$BUILD_DIR"
+
+# Configure with static linking enabled
+cmake -GNinja \
+    -DCMAKE_BUILD_TYPE="$BUILD_TYPE" \
+    -DCMAKE_INSTALL_PREFIX="$INSTALL_PREFIX" \
+    -DBUILD_STATIC=ON \
+    -DATMOSIC_ZSG=ON \
+    ..
+
+# Build
+ninja
+
+# Find the binary
+BINARY_PATH=""
+if [ -f "src/zsg" ]; then
+    BINARY_PATH="src/zsg"
+elif [ -f "zsg" ]; then
+    BINARY_PATH="zsg"
+else
+    echo "ERROR: Binary not found in expected locations (src/zsg or zsg)"
+    exit 1
+fi
+
+# Verify the binary is statically linked
+echo ""
+echo "Checking binary linkage..."
+if command -v ldd &> /dev/null; then
+    echo "Running 'ldd $BINARY_PATH':"
+    ldd "$BINARY_PATH" || echo "Binary is statically linked (ldd failed as expected)"
+fi
+
+if command -v file &> /dev/null; then
+    echo ""
+    echo "File type:"
+    file "$BINARY_PATH"
+fi
+
+echo ""
+echo "Build complete! Binary location: $BUILD_DIR/$BINARY_PATH"
+echo ""
+echo "To test the binary, run:"
+echo "  $BUILD_DIR/$BINARY_PATH --help"
+echo ""
+echo "To install, run: ninja install"
+echo "Or copy manually: cp $BUILD_DIR/$BINARY_PATH /usr/local/bin/zsg"
+
