+std::string find_tag_attr(std::string const& tag_name)
+{
+    std::string attr_name = "", attr_value = "";
+
+    for (size_t i = 0; i < attributes.size(); ++i)
+    {
+        AtmUtil::splitKeyValue(attributes[i], attr_name, attr_value);
+        if (attr_name == tag_name)
+        {
+            return attr_value;
+        }
+    }
+    return "";
