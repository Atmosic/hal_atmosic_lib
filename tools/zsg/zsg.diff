+static std::string classify_id(uint16_t id)
+{
+    if (id == 0xFFFF) return "CLOSE/GC";
+    if (id == NVS_NAMECNT_ID) return "NAMECNT";
+    if (id > NVS_NAMECNT_ID && id < (NVS_NAMECNT_ID + NVS_NAME_ID_OFFSET))
+        return "NAME";
+    if (id >= (NVS_NAMECNT_ID + NVS_NAME_ID_OFFSET) && id < 0xFFFF)
+        return "VALUE";
+    return "OTHER";
+}
+
+static bool ate_is_erased(const uint8_t *buf, size_t len, uint8_t erase_value)
+{
+    for (size_t i = 0; i < len; ++i) {
+        if (buf[i] != erase_value)
+            return false;
+    }
+    return true;
+}
