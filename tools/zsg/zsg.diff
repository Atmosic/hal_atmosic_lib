+int scan_nvs_ate(int argc, char* argv[])
+{
+    if (argc != 5)
+    {
+        AtmLog::log_error("Usage: " + std::string(argv[0]) + " " + \
+            std::string(argv[1]) + " [bin_file] [partition_sector_size] " \
+            "[partition_size]");
+        return 1;
+    }
+
+    std::string bin_file = argv[2];
+    uint16_t block_size = AtmUtil::str2uint16(argv[3]);
+    uint16_t part_size = AtmUtil::str2uint16(argv[4]);
+
+    if (block_size == 0 || part_size == 0)
+    {
+        AtmLog::log_error("Both partition_sector_size and partition_size " \
+            "must be greater than 0");
+        return 1;
+    }
+    if (!fs::exists(bin_file))
+    {
+        AtmLog::log_error("Can't find " + bin_file + " file");
+        return 1;
+    }
+
+    // Compute NVS layout exactly like settings_backend_init (ATMOSIC_ZSG path)
+    size_t nvs_sector_size = CONFIG_SETTINGS_NVS_SECTOR_SIZE_MULT * block_size;
+    size_t nvs_size = 0;
+    uint16_t cnt = 0;
+    while (cnt < CONFIG_SETTINGS_NVS_SECTOR_COUNT)
+    {
+        nvs_size += nvs_sector_size;
+        if (nvs_size > part_size) break;
+        cnt++;
+    }
+    if (cnt == 0)
+    {
+        AtmLog::log_error("Computed sector_count is 0; check sizes");
+        return 1;
+    }
+
+    // Prepare a temporary nvs_fs bound to the file
+    struct nvs_fs fs_local{};
+    fs_local.sector_size = static_cast<uint16_t>(nvs_sector_size);
+    fs_local.sector_count = cnt;
+    fs_local.offset = 0;
+    fs_local.flash_device = flash_open((uint16_t)nvs_sector_size, cnt,
+        bin_file.c_str());
+    if (fs_local.flash_device == nullptr)
+    {
+        AtmLog::log_error("flash_open failed");
+        return 1;
+    }
+
+    // Mount to populate flash parameters (erase_value/write_block_size)
+    if (nvs_mount(&fs_local) != 0)
+    {
+        AtmLog::log_error("nvs_mount failed");
+        return 1;
+    }
+
+    const uint8_t erase_value = fs_local.flash_parameters->erase_value;
+    // write_block_size is 1 in our env
+    const size_t ate_size = sizeof(struct nvs_ate);
+
+    AtmLog::log_info("********* RAW ATE SCAN START *********");
+    AtmLog::log_info("sectors=" + std::to_string(fs_local.sector_count) +
+                     ", sector_size=" + std::to_string(fs_local.sector_size) +
+                     ", ate_size=" + std::to_string(ate_size));
+
+    std::vector<uint8_t> ate_buf(ate_size);
+    std::vector<std::string> scan_lines;
+    std::unordered_map<std::string, size_t> id_to_line;
+
+    char name_buf[128];
+    // cleared: tag id tracking handled via id_to_line
+    for (uint16_t s = 0; s < fs_local.sector_count; ++s)
+    {
+        off_t sector_base = fs_local.offset + static_cast<off_t>(s) * \
+            fs_local.sector_size;
+        for (int ate_off = static_cast<int>(fs_local.sector_size) - \
+            static_cast<int>(ate_size); ate_off >= 0; \
+            ate_off -= static_cast<int>(ate_size))
+        {
+            off_t file_off = sector_base + ate_off;
+            if (flash_read(fs_local.flash_device, file_off, ate_buf.data(),
+                ate_size) != 0)
+            {
+                AtmLog::log_error("flash_read failed at sector " + \
+                    std::to_string(s));
+                return 1;
+            }
+
+            if (ate_is_erased(ate_buf.data(), ate_size, erase_value))
+            {
+                continue; // skip fully erased slots
+            }
+
+            struct nvs_ate ate;
+            memcpy(&ate, ate_buf.data(), ate_size);
+
+            // Validate CRC and basic bounds
+            uint8_t crc = crc8_ccitt(0xFF, &ate,
+                offsetof(struct nvs_ate, crc8));
+            bool crc_ok = (crc == ate.crc8);
+            bool offs_ok = (ate.offset < (fs_local.sector_size - ate_size));
+
+            std::ostringstream oss;
+            std::ostringstream id_ss;
+            id_ss << "0x" << std::uppercase << std::hex
+                  << std::setw(4) << std::setfill('0') << ate.id;
+            std::string ate_id_str = id_ss.str();
+
+            oss << "Sector=" << s
+                << " ATE_OFF=0x" << std::hex << std::uppercase << ate_off
+                << " ID=" << ate_id_str
+                << std::dec
+                << " LEN=" << ate.len
+                << std::dec
+                << " TYPE=" << classify_id(ate.id);
+
+            if (!crc_ok || !offs_ok) {
+                continue;
+            }
+
+            // Skip non-NAME entries
+            if (ate.id <= NVS_NAMECNT_ID || ate.id > (NVS_NAMECNT_ID + \
+                NVS_NAME_ID_OFFSET)) {
+                continue;
+            }
+
+            // If this looks like a NAME entry, try to read and print the name
+            size_t to_read = std::min<size_t>(sizeof(name_buf) - 1, ate.len);
+            if (ate.offset + to_read > fs_local.sector_size) {
+                continue;
+            }
+
+            // Read the name
+            if (flash_read(fs_local.flash_device, sector_base + \
+                ate.offset, name_buf, to_read) != 0) {
+                continue;
+            }
+
+            name_buf[to_read] = '\0';
+            for (size_t i = 0; i < to_read; ++i)
+            {
+                const unsigned char uc =
+                    static_cast<unsigned char>(name_buf[i]);
+                if (uc < 0x20 || uc > 0x7E)
+                {
+                    name_buf[i] = '.';
+                }
+            }
+            oss << " >> NAME=\"" << name_buf << "\"";
+
+            // Integrate duplicate handling into id_to_line
+            auto [it_line, inserted] = id_to_line.try_emplace(
+                ate_id_str, scan_lines.size());
+            if (inserted) {
+                // First time: store original OSS content
+                scan_lines.push_back(oss.str());
+            } else {
+                // Duplicate: append note based on length
+                scan_lines[it_line->second] += (ate.len == 0)
+                    ? " (len=0 so removed)" : " (duplicated)";
+            }
+        }
+    }
+
+    // Print collected lines once, with duplicate annotations appended
+    for (const auto& line : scan_lines) {
+        AtmLog::log_info(line);
+    }
+
+    AtmLog::log_info("********* RAW ATE SCAN END *********");
+    return 0;
+}
+
+
+int bin_to_yaml(int argc, char* argv[])
+{
+    if (argc != 7)
+    {
+        AtmLog::log_error("Usage: " + std::string(argv[0]) + " " + \
+            std::string(argv[1]) + " [bin_file] [FACTORY | SETTINGS] " + \
+            "[partition_sector_size] [partition_size] [yaml_output_file]");
