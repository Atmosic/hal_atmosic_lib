+        << "       [partition_sector_size]\n"
+        << "       [partition_size] [show_pretty | show_verbose]\n"
+        << "       Display current binary file information\n\n"
+        << "  scan [bin_file] [partition_sector_size] [partition_size]\n"
+        << "       Raw ATE scan (lists all ATEs with validity, id, len,\n"
+        << "       off, type; "
+        << "forensics mode)\n\n";
+}
+
+int AtmTool::run_tool(int argc, char *argv[])
+{
+    if (argc == 1) {
+        print_usage();
+        return 1;
+    }
+
+    AtmLog::set_level(AtmLog::LOG_INFO);
+    if (strcmp(argv[1], "--help") == 0 || strcmp(argv[1], "-h") == 0)
+    {
+        print_usage();
+    }
+    else if (strcmp(argv[1], "write") == 0)
+    {
+        return yaml_to_bin(argc, argv);
+    }
+    else if (strcmp(argv[1], "read") == 0)
+    {
+        return bin_to_yaml(argc, argv);
+    }
+    else if (strcmp(argv[1], "show") == 0)
+    {
+        return show_bin_info(argc, argv);
+    }
+    else if (strcmp(argv[1], "scan") == 0)
+    {
+        return scan_nvs_ate(argc, argv);
+    }
+    else
+    {
+        std::string arg = argv[1];
+        AtmLog::log_error("Unknow action [" + arg + "]");
+        return 1;
+    }
+    return 0;
+}
