+# SPDX-FileCopyrightText: 2025 Atmosic
+# SPDX-License-Identifier: Apache-2.0
+#
+# Convenience Makefile for building zephyr-settings-generator
+
+.PHONY: all static dynamic clean install help
+
+# Default target
+all: static
+
+# Build statically linked binary (recommended for cross-distribution compatibility)
+static:
+	@echo "Building static binary..."
+	@./build_static.sh
+
+# Build dynamically linked binary (smaller, but may have compatibility issues)
+dynamic:
+	@echo "Building dynamic binary..."
+	@mkdir -p build
+	@cd build && cmake -GNinja -DCMAKE_BUILD_TYPE=Release -DATMOSIC_ZSG=ON .. && ninja
+
+# Clean all build artifacts
+clean:
+	@echo "Cleaning build directories..."
+	@rm -rf build build-static
+
+# Install the binary (requires sudo for system-wide installation)
+install:
+	@if [ -f build-static/src/zsg ]; then \
+		echo "Installing static binary..."; \
+		cd build-static && ninja install; \
+	elif [ -f build/src/zsg ]; then \
+		echo "Installing dynamic binary..."; \
+		cd build && ninja install; \
+	else \
+		echo "Error: No binary found. Run 'make static' or 'make dynamic' first."; \
+		exit 1; \
+	fi
+
+# Show help
+help:
+	@echo "Zephyr Settings Generator - Build Targets"
+	@echo ""
+	@echo "Usage: make [target]"
+	@echo ""
+	@echo "Targets:"
+	@echo "  all (default)  - Build static binary"
+	@echo "  static         - Build statically linked binary (recommended)"
+	@echo "  dynamic        - Build dynamically linked binary"
+	@echo "  clean          - Remove all build artifacts"
+	@echo "  install        - Install binary to system (requires sudo)"
+	@echo "  help           - Show this help message"
+	@echo ""
+	@echo "Environment Variables:"
+	@echo "  BUILD_DIR      - Build directory (default: build-static)"
+	@echo "  BUILD_TYPE     - CMake build type (default: Release)"
+	@echo "  INSTALL_PREFIX - Installation prefix (default: /usr/local)"
+	@echo ""
+	@echo "Examples:"
+	@echo "  make static                    # Build static binary"
+	@echo "  make clean && make static      # Clean rebuild"
+	@echo "  sudo make install              # Install to /usr/local/bin"
+	@echo "  BUILD_TYPE=Debug make static   # Build debug version"
+
