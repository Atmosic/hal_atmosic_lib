+@echo off
+REM SPDX-FileCopyrightText: 2025 Atmosic
+REM SPDX-License-Identifier: Apache-2.0
+
+REM Script to build zephyr-settings-generator as a statically linked binary on Windows
+REM This creates a binary that includes the C/C++ runtime and can run on any Windows system
+
+setlocal enabledelayedexpansion
+
+REM Configuration
+set BUILD_DIR=build-static
+set BUILD_TYPE=Release
+set GENERATOR=Ninja
+
+REM Check if user wants to clean
+if "%1"=="clean" (
+    echo Cleaning build directory...
+    if exist %BUILD_DIR% rmdir /s /q %BUILD_DIR%
+)
+
+REM Check for CMake
+where cmake >nul 2>nul
+if %ERRORLEVEL% neq 0 (
+    echo ERROR: CMake not found in PATH
+    echo Please install CMake and add it to your PATH
+    exit /b 1
+)
+
+REM Check for Ninja (optional, will fall back to Visual Studio)
+where ninja >nul 2>nul
+if %ERRORLEVEL% neq 0 (
+    echo WARNING: Ninja not found, using Visual Studio generator
+    set GENERATOR=Visual Studio 17 2022
+)
+
+echo ========================================
+echo Building zephyr-settings-generator (Windows Static)
+echo ========================================
+echo Build directory: %BUILD_DIR%
+echo Build type: %BUILD_TYPE%
+echo Generator: %GENERATOR%
+echo ========================================
+echo.
+
+REM Create build directory
+if not exist %BUILD_DIR% mkdir %BUILD_DIR%
+cd %BUILD_DIR%
+
+REM Configure with CMake
+echo Configuring with CMake...
+if "%GENERATOR%"=="Ninja" (
+    cmake -G "%GENERATOR%" ^
+        -DCMAKE_BUILD_TYPE=%BUILD_TYPE% ^
+        -DBUILD_STATIC=ON ^
+        -DATMOSIC_ZSG=ON ^
+        ..
+) else (
+    cmake -G "%GENERATOR%" ^
+        -DBUILD_STATIC=ON ^
+        -DATMOSIC_ZSG=ON ^
+        ..
+)
+
+if %ERRORLEVEL% neq 0 (
+    echo ERROR: CMake configuration failed
+    cd ..
+    exit /b 1
+)
+
+REM Build
+echo.
+echo Building...
+if "%GENERATOR%"=="Ninja" (
+    ninja
+) else (
+    cmake --build . --config %BUILD_TYPE%
+)
+
+if %ERRORLEVEL% neq 0 (
+    echo ERROR: Build failed
+    cd ..
+    exit /b 1
+)
+
+REM Find the binary
+if "%GENERATOR%"=="Ninja" (
+    set BINARY_PATH=src\zsg.exe
+) else (
+    set BINARY_PATH=src\%BUILD_TYPE%\zsg.exe
+)
+
+REM Verify the binary exists
+if not exist %BINARY_PATH% (
+    echo ERROR: Binary not found at %BINARY_PATH%
+    echo Searching for binary...
+    if exist src\zsg.exe (
+        set BINARY_PATH=src\zsg.exe
+        echo Found at src\zsg.exe
+    ) else if exist src\%BUILD_TYPE%\zsg.exe (
+        set BINARY_PATH=src\%BUILD_TYPE%\zsg.exe
+        echo Found at src\%BUILD_TYPE%\zsg.exe
+    ) else if exist zsg.exe (
+        set BINARY_PATH=zsg.exe
+        echo Found at zsg.exe
+    ) else if exist %BUILD_TYPE%\zsg.exe (
+        set BINARY_PATH=%BUILD_TYPE%\zsg.exe
+        echo Found at %BUILD_TYPE%\zsg.exe
+    ) else (
+        echo ERROR: Binary not found in any expected location
+        cd ..
+        exit /b 1
+    )
+)
+
+echo.
+echo ========================================
+echo Build complete!
+echo ========================================
+echo Binary location: %BUILD_DIR%\%BINARY_PATH%
+echo.
+
+REM Check dependencies
+echo Checking binary dependencies...
+where dumpbin >nul 2>nul
+if %ERRORLEVEL% equ 0 (
+    echo.
+    echo DLL Dependencies:
+    dumpbin /dependents "%BINARY_PATH%" | findstr /i ".dll"
+    echo.
+    echo Note: Only system DLLs ^(kernel32.dll, etc.^) should be listed
+) else (
+    echo Note: dumpbin not found. Install Visual Studio to check dependencies.
+)
+
+echo.
+echo To test the binary, run:
+echo   %BUILD_DIR%\%BINARY_PATH% --help
+echo.
+
+cd ..
+endlocal
+
